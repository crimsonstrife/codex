{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "crimsonstrife/codex",
    "type": "project",
    "description": "Codex – documentation management and planning, a Confluence-like companion to Forge.",
    "keywords": ["laravel", "documentation", "wiki", "codex"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "achyutn/filament-log-viewer": "^1.4",
        "calebporzio/sushi": "^2.5",
        "doctrine/dbal": "^4.3",
        "filament/filament": "^4.0",
        "filament/spatie-laravel-settings-plugin": "^4.0",
        "guzzlehttp/guzzle": "^7.10",
        "jfcherng/php-diff": "^6.16",
        "kalnoy/nestedset": "^6.0",
        "laravel/folio": "^1.1",
        "laravel/framework": "^12.0",
        "laravel/jetstream": "^5.3",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^11.1",
        "laravel/socialite": "^5.23",
        "laravel/tinker": "^2.10",
        "league/html-to-markdown": "^5.1",
        "livewire/livewire": "^3.6.4",
        "livewire/volt": "^1.7",
        "mews/purifier": "^3.4",
        "nesbot/carbon": "^3.10",
        "predis/predis": "^3.4",
        "spatie/cpu-load-health-check": "^1.0",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-data": "^4.17",
        "spatie/laravel-health": "^1.34",
        "spatie/laravel-markdown": "^2.7",
        "spatie/laravel-medialibrary": "^11.14",
        "spatie/laravel-permission": "^6.21",
        "spatie/laravel-settings": "^3.4",
        "spatie/laravel-sluggable": "^3.7",
        "spatie/laravel-tags": "^4.10",
        "spatie/security-advisories-health-check": "^1.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^12.4",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
